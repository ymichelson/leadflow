# Copy this file to .env and fill in what you have.
# Everything here is optional - the system runs with none of it set,
# it just runs in a degraded, honest mode (see README).
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real keys.

# ---- Claude (classification) ----------------------------------------------
# Without it: every inquiry gets confidence 0 and goes to human review.
# New Anthropic accounts get free trial credits; a full eval.py run is ~4 cents.
ANTHROPIC_API_KEY=

# Free demo alternative. Get a Gemini Developer API key from Google AI Studio.
# Use only synthetic/demo inquiries on the free tier, not real customer PII.
GEMINI_API_KEY=
AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash

# Optional: use the cheaper model. Haiku is about half the price of Sonnet.
# CLAUDE_MODEL=claude-haiku-4-5

# ---- HubSpot (the CRM - free account is enough) ----------------------------
# Private App token from Settings -> Integrations -> Private Apps.
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.schemas.contacts.write, crm.objects.notes.write
# Without it: leads are parked in the retry queue instead of written.
HUBSPOT_TOKEN=

# ---- WhatsApp (Meta) -------------------------------------------------------
# Only needed to receive real WhatsApp messages. The website form works without.
WHATSAPP_VERIFY_TOKEN=
APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# ---- Business rules (safe defaults, change only if the client differs) ------
# REPS=דנה,יוסי,מאיה
# CONFIDENCE_THRESHOLD=70
# SLA_HOURS=4
# WORK_DAYS=sun,mon,tue,wed,thu
# WORK_START=9
# WORK_END=18
# BUSINESS_TZ=Asia/Jerusalem
# STATE_DB=leadflow_queue.db
# RETRY_DB=leadflow_queue.db  # backwards-compatible fallback
# EXPOSE_DEMO_PII=false
